{
  "name": "creonome",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node --env-file-if-exists=.env --run build:workspace",
    "build:workspace": "turbo run build --env-mode=loose",
    "dev": "node --env-file-if-exists=.env --run dev:workspace",
    "dev:workspace": "pnpm --filter @creonome/contracts build && pnpm --filter @creonome/config build && turbo run dev --env-mode=loose",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node --env-file-if-exists=.env --run lint:workspace",
    "lint:workspace": "turbo run lint --env-mode=loose",
    "test": "node --env-file-if-exists=.env --run test:workspace",
    "test:workspace": "turbo run test --env-mode=loose",
    "typecheck": "node --env-file-if-exists=.env --run typecheck:workspace",
    "typecheck:workspace": "turbo run typecheck --env-mode=loose"
  },
  "dependencies": {
    "next": "catalog:"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.8",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@better-auth/core": "1.6.22",
      "@better-auth/passkey": "1.6.22",
      "@better-auth/utils": "0.4.2",
      "@better-fetch/fetch": "1.3.1",
      "@fastify/static": "10.1.2",
      "better-auth": "1.6.22",
      "better-call": "1.3.7",
      "find-my-way": "9.7.0",
      "js-yaml": "5.2.2",
      "postcss": "8.5.25",
      "sharp": "0.35.0"
    },
    "patchedDependencies": {
      "@neondatabase/auth-ui@0.2.1-beta": "patches/@neondatabase__auth-ui@0.2.1-beta.patch"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@fastify/static": ">=9 <11",
        "@better-fetch/fetch": ">=1.1.21 <2",
        "typescript": ">=5 <8"
      }
    }
  }
}
