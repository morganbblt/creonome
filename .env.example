# Creonome local environment template
# Copy to .env for local orchestration only. Never commit the populated file.
# Vercel and Cloud Run receive their variables through their own environment stores.

# Application
NODE_ENV=development
APP_ENV=local
DEMO_MODE=true
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000
API_PREFIX=api
CORS_ALLOWED_ORIGINS=http://localhost:3000
SESSION_COOKIE_SECURE=false

# Browser-visible values. Never put a secret behind NEXT_PUBLIC_.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_BILLING_MODE=mock

# Neon Postgres
# DATABASE_URL should use the pooled endpoint at runtime.
# DIRECT_DATABASE_URL should use the direct endpoint for migrations only.
DATABASE_URL=
DIRECT_DATABASE_URL=

# Neon Auth v0.2+
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# At least 32 characters; keep stable across deployments in the same environment.
NEON_AUTH_COOKIE_SECRET=
# Google sign-in uses Neon Auth's shared Google provider in the MVP, so no
# GOOGLE_CLIENT_ID or GOOGLE_CLIENT_SECRET is required locally.

# Google Cloud
GOOGLE_CLOUD_PROJECT=creonome
GOOGLE_CLOUD_LOCATION=global
GCP_PROJECT_NUMBER=909754432431
GCP_REGION=europe-west9
GCP_ARTIFACT_REGISTRY=creonome-containers
GCP_MEDIA_BUCKET=creonome-909754432431-media
# Cloud Tasks is not available in europe-west9.
GCP_TASKS_LOCATION=europe-west1
GCP_TASKS_QUEUE=creonome-generation
GCP_API_SERVICE_ACCOUNT=creonome-api@creonome.iam.gserviceaccount.com
GCP_WORKER_SERVICE_ACCOUNT=creonome-worker@creonome.iam.gserviceaccount.com
WORKER_BASE_URL=

# Gemini and Lyria
# Production value already lives in GCP Secret Manager as gemini-api-key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Multimodal onboarding runs on Vertex AI with Cloud Run service identity.
# Keep this equal to GEMINI_MODEL above — see packages/config/src/api-env.ts.
VERTEX_AI_MODEL=gemini-3.6-flash
# Video rendering always keeps the deterministic fallback available.
# auto: try Veo, then fallback; veo: prefer Veo, then fallback; deterministic: skip Veo.
VIDEO_PROVIDER=auto
# auto: Vertex AI when GOOGLE_CLOUD_PROJECT is configured, otherwise Gemini API.
VEO_BACKEND=auto
VEO_VERTEX_LOCATION=us-central1
VEO_VERTEX_MODEL=veo-3.1-fast-generate-001
VEO_GEMINI_MODEL=veo-3.1-fast-generate-preview
VEO_POLL_INTERVAL_MS=10000
VEO_TIMEOUT_MS=240000
LYRIA_MODEL=lyria-3-clip-preview
FEATURE_LYRIA=false

# Mem0
MEM0_API_KEY=

# Transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL="Creonome <noreply@example.com>"

# Post-MVP placeholders: TikTok developer app credentials belong to Creonome,
# never to an individual user. Leave empty while social connections are disabled.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://api.example.com/api/v1/integrations/tiktok/callback

# Post-MVP placeholders: one Creonome Meta app, never one app per end user.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://api.example.com/api/v1/integrations/meta/callback

# Encrypt per-user OAuth access and refresh tokens before database storage.
SOCIAL_OAUTH_ENCRYPTION_KEY=
FEATURE_SOCIAL_CONNECTIONS=false

# Hackathon billing: UI and credits are synthetic, with no payment processor.
BILLING_MODE=mock
DEFAULT_CREDIT_BALANCE=60
FEATURE_STRIPE=false

# Reserved for a later Stripe integration; leave empty for the hackathon.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Shared secret for trusted internal callers (e.g. a Cloud Scheduler job, or
# a Cloud Tasks push task) invoking service-to-service endpoints such as
# POST /api/v1/privacy/account-deletion/execute-due and the
# /api/v1/internal/{opportunity,project}-jobs/:jobId/execute generation-job
# handlers. Also required to enqueue generation jobs at all (see
# GenerationJobEnqueueService): without it, generation-triggering endpoints
# fail with a clear 503 instead of running inline or crashing. Leave empty
# to keep those endpoints disabled.
INTERNAL_JOB_TOKEN=
